# Phase 2.4 Revised - Cloud Development Testing Configuration
# Copy to .env.test (local only, NOT committed to git)
#
# This configuration enables integration tests against a cloud Supabase development project.
# See DEVELOPMENT_SETUP.md for step-by-step instructions to obtain these values.

# Required for all tests
NODE_ENV=test

# Supabase Development Project
# Get these from: https://supabase.com/dashboard
# Project Settings → API → Copy below values

# Example: https://abcdefgh.supabase.co (NO trailing slash)
TEST_SUPABASE_URL=https://your-project-ref.supabase.co

# Example: abcdefgh (the part before .supabase.co)
# CRITICAL: Safety guard will verify this matches the URL
TEST_SUPABASE_PROJECT_REF=your-project-ref

# Get from: Project Settings → API → Anon Key (public, safe)
# This key is used to test RLS policies (should be denied for direct mutations)
TEST_SUPABASE_ANON_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...

# Get from: Project Settings → API → Service Role Key (secret, server-only)
# CRITICAL: Never commit this. Never share this. Keep it secure.
# This key is used by tests to set up test data and clean up
TEST_SUPABASE_SERVICE_ROLE_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...

# Safety switch: Must be 'true' to allow cloud database testing
# Prevents accidental production mutations
ALLOW_REMOTE_TEST_DATABASE=true

# Optional: Logging (default: info)
# LOG_LEVEL=debug

# Optional: Environment name (for logs and monitoring)
# ENVIRONMENT=development
