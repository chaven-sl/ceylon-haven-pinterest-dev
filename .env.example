# Facebook Graph API
FB_GRAPH_API_VERSION=v26
FACEBOOK_PAGE_ID=114332506932644
FACEBOOK_ACCESS_TOKEN=your_page_access_token_here

# Pinterest API
PINTEREST_APP_ID=your_app_id_here
PINTEREST_APP_SECRET=your_app_secret_here

# Token Encryption (Phase 3)
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=your_32_byte_base64_key_here

# Database (Supabase)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Security
CRON_SECRET=your_cron_secret_here

# Environment
ENVIRONMENT=development
LOG_LEVEL=info
NODE_ENV=development
